# Build context for the site image: send only what the Dockerfile copies (keeps .env, datasets and .git out).
# The Rust client is compiled in a build stage; only its binary reaches the final image, never the source.
*
!dashboard/server.py
!dashboard/auth.py
!dashboard/repo_fetch.py
!dashboard/scanner.py
!dashboard/scan_worker.py
!site
!client/Cargo.toml
!client/Cargo.lock
!client/src
**/__pycache__
**/*.pyc
**/target
