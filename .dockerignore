# Build context for the dashboard image: send only what the Dockerfile copies (keeps .env, datasets and .git out).
*
!dashboard/index.html
!dashboard/benchmarks.html
!dashboard/server.py
!dashboard/auth.py
!dashboard/repo_fetch.py
!dashboard/scanner.py
!dashboard/scan_worker.py
!krypton/pyproject.toml
!krypton/krypton/**
**/__pycache__
**/*.pyc
