# Settings for the demo server (Railway: add these under Variables; locally: copy to .env, which git ignores).
# Create the OAuth App at GitHub > Settings > Developer settings > OAuth Apps > New OAuth App:
#   Homepage URL                 = BASE_URL
#   Authorization callback URL   = BASE_URL/auth/github/callback      (an OAuth App accepts one callback URL, so use one app per environment)

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
BASE_URL=https://your-app.up.railway.app
# any long random string, for example: python -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_SECRET=
# optional: ask GitHub for less access. The default "read:user repo" lets visitors analyze private repositories;
# "read:user public_repo" limits the analysis to public ones.
# GITHUB_SCOPES=read:user public_repo
