# Settings for the site server (Railway: add these under Variables; locally: copy to .env, which git ignores). Steps: dashboard/DEPLOY.md.

# The GitHub App (Settings > Developer settings > GitHub Apps): Contents read-only, Metadata read-only, callback BASE_URL/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_APP_SLUG=
BASE_URL=https://your-site.up.railway.app
# any long random string, for example: python -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_SECRET=

# The Krypton scoring server, and the site's service token for it (krypton-server --mint website 365, run where KRYPTON_JWT_SECRET is set)
KRYPTON_SCORE_URL=https://your-krypton-server.up.railway.app
KRYPTON_SERVICE_TOKEN=
