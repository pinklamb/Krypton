# Rust build output
target/

# Python caches (the demo and its tests are Python)
__pycache__/
*.py[cod]
.pytest_cache/

# secrets: environment files, keys, and a Krypton login copied by mistake
.env
.env.*
!.env.example
*.pem
*.key
keys.json
credentials
credentials.json

# Krypton's own folder (run log, attempts, settings, token counts); it also ignores itself with its own .gitignore
.krypton/

# demo design scratch and local notes
dashboard/previews/
*.local.md

# local editor and agent state
.claude/
.vscode/
